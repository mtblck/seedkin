{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run site",
  "outputDirectory": "dist-site",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "botling.me" }],
      "destination": "https://seedkin.dev/styles/botling/",
      "permanent": true
    },
    { "source": "/styles", "destination": "/styles/", "permanent": true },
    { "source": "/styles/botling", "destination": "/styles/botling/", "permanent": true },
    { "source": "/styles/snoot", "destination": "/styles/snoot/", "permanent": true },
    { "source": "/styles/beastie", "destination": "/styles/beastie/", "permanent": true },
    { "source": "/styles/sprite", "destination": "/styles/sprite/", "permanent": true },
    { "source": "/styles/noggin", "destination": "/styles/noggin/", "permanent": true },
    { "source": "/docs", "destination": "/docs/", "permanent": true },
    {
      "source": "/docs/:page(react|vue|svelte|html|server|api|fallback|botling|snoot|noggin|beastie|sprite|how-it-works|versioning)",
      "destination": "/docs/:page/",
      "permanent": true
    },
    { "source": "/about", "destination": "/about/", "permanent": true },
    { "source": "/changelog", "destination": "/changelog/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy/", "permanent": true },
    { "source": "/licences", "destination": "/licences/", "permanent": true },
    { "source": "/licenses", "destination": "/licences/", "permanent": true },
    { "source": "/licenses/", "destination": "/licences/", "permanent": true }
  ],
  "rewrites": [{ "source": "/_mb/events", "destination": "https://mattblack.space/boards/api/events" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
